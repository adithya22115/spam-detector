# Copy to .env and edit as needed. app/app.py loads this file via python-dotenv
# (optional dependency). Every value below is the default, so an empty .env is
# equivalent to not having one.

# Flask bind address and port.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# Path to the trained model, relative to the project root.
MODEL_PATH=models/spam_model.pkl

# Largest message the API will accept, in characters. Longer payloads get a 400.
MAX_MESSAGE_CHARS=20000
